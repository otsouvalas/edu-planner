# Production env for the Docker deployment.
#
# Copy to `.env` NEXT TO docker-compose.yml on the host (e.g. /opt/edu-planner/.env)
# and fill it in. This file is read by docker-compose (`env_file`) and never
# baked into the image — `.env` is git- and docker-ignored.
#
#   cp .env.production.example .env && $EDITOR .env

# Anthropic key for the AI endpoints. Leave empty to run without AI:
# the CRUD app works normally and the AI endpoints return 503.
ANTHROPIC_API_KEY=

# Required ONLY if your key is "identity-linked" (a personal key tied to your
# account across several workspaces). Looks like wrkspc_...
ANTHROPIC_WORKSPACE_ID=

# Optional. Fallback model when no `claude.model` row is set in the database
# (the model is editable at runtime from the UI: ⚙ Ρυθμίσεις).
# ANTHROPIC_MODEL=claude-sonnet-5

# Port the app listens on INSIDE the container. The compose file publishes
# the same number on the host, so changing this changes both.
PORT=4000

# SQLite file, inside the `edu-planner-data` volume mounted at /app/data.
# Only change this if you also change the volume mount in docker-compose.yml.
DATABASE_URL=file:/app/data/prod.db

# Copy this file to server/.env and fill in your key.
# Without a key the CRUD API still works; only the AI endpoints return 503.
ANTHROPIC_API_KEY=

# Required ONLY if your key is "identity-linked" (personal key tied to your
# account across multiple workspaces) — the API will reject requests with
# "anthropic-workspace-id is required..." until this is set. Find it in
# console.anthropic.com under Settings > Workspaces > (your workspace) > the
# id in the URL (looks like wrkspc_...).
ANTHROPIC_WORKSPACE_ID=

# Optional. Defaults to 4000.
PORT=4000

# SQLite location. Relative paths resolve against server/prisma/.
# (In Docker this is set to file:/app/data/prod.db — see .env.production.example.)
DATABASE_URL=file:./dev.db
